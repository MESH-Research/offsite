# offsite-backup environment contract
#
# Copy to .env for local runs (never commit .env). In production these arrive
# via the ECS task definition; secrets (passwords, keys, ping URL) must come
# from Secrets Manager `secrets`/`valueFrom` entries, not plain `environment`.
#
# NOTE: multiline values (the SSH private keys) survive ECS secret injection
# and `docker compose` env files, but NOT `docker run --env-file` — for plain
# docker use `-e SSH_PRIVATE_KEY="$(cat key)"` instead.
#
# AWS credentials are not configured here: the container uses the standard
# boto3 credential chain (ECS task role in production, AWS_PROFILE/AWS_*
# variables locally). Set AWS_REGION if no default region is configured.

# ── Primary restic repository (required) ─────────────────────────────────────
# Either restic form works:
#   scp-like: sftp:USER@HOST:./repo          (no port; SSH_PORT applies)
#   URL:      sftp://USER@HOST:PORT/./repo   (embedded port wins over SSH_PORT)
# Local paths (local:/backups/repo) are accepted for smoke testing.
RESTIC_REPOSITORY=sftp:uXXXXXX-sub1@uXXXXXX.your-storagebox.de:./repo
RESTIC_PASSWORD=change-me

# Stable snapshot host label (restic --host; the name matches restic's own
# built-in $RESTIC_HOST variable). This is the FROM side: it names the backup
# *source* recorded inside each snapshot — never the storage server. Keep one
# label for the whole fleet, identical across primary and mirrors; Fargate
# container hostnames are random, which would break forget grouping and
# parent-snapshot selection. See docs/FAQ.md.
#RESTIC_HOST=mesh-offsite

# Restic metadata cache; point at ephemeral storage in ECS.
#RESTIC_CACHE_DIR=/var/cache/restic

# SSH material for sftp repositories (required when the repository is sftp).
# Multiline PEM: see note above.
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"
SSH_KNOWN_HOSTS=uXXXXXX.your-storagebox.de ssh-ed25519 AAAA...
# Hetzner Storage Boxes use SSH on port 23.
#SSH_PORT=23

# ── Mirror repositories (optional, numbered from 1, no gaps) ─────────────────
# Every backup is copied to each mirror (restic copy); forget/prune/check run
# per repository. A mirror may live on a completely different host with its
# own credentials; SSH material and port default to the primary's when unset.
#RESTIC_MIRROR_1_REPOSITORY=sftp:uYYYYYY-sub1@uYYYYYY.your-storagebox.de:./repo
#RESTIC_MIRROR_1_PASSWORD=change-me-too
#RESTIC_MIRROR_1_SSH_PRIVATE_KEY=
#RESTIC_MIRROR_1_SSH_KNOWN_HOSTS=
#RESTIC_MIRROR_1_SSH_PORT=23

# ── Database sources ─────────────────────────────────────────────────────────
# Comma-separated list of source names; each needs a DB_<NAME>_* group below
# (name uppercased). Names are also usable as CLI targets: `backup idms`.
# Reserved names: db, ecs, efs, s3, all.
#DB_SOURCES=wordpress,invenio,idms

# Per-source settings. ENGINE is mariadb or postgres.
#DB_WORDPRESS_ENGINE=mariadb
#DB_WORDPRESS_INSTANCE_ID=kc-wordpress-prod
#DB_WORDPRESS_USER=backup
#DB_WORDPRESS_PASSWORD=change-me
#DB_WORDPRESS_DATABASES=commons
# Instance class for the temporary read replica (default: same as source).
#DB_WORDPRESS_REPLICA_CLASS=db.r6g.large
# Security groups attached to the replica so this task can reach it.
#DB_WORDPRESS_SECURITY_GROUP_IDS=sg-xxxxxxxx
# Postgres only: parameter group raising max_standby_streaming_delay so the
# dump is not cancelled by replication replay.
#DB_WORDPRESS_PARAMETER_GROUP=

# Shared replica lifecycle limits (seconds).
#REPLICA_TIMEOUT_SECONDS=7200
#REPLICA_LAG_WAIT_SECONDS=1800

# ── S3 ───────────────────────────────────────────────────────────────────────
# Buckets to back up; unset = discover all buckets, minus excludes.
#S3_BUCKETS=kc-assets,kc-uploads
#S3_EXCLUDE_BUCKETS=kc-scratch
# Staging area for bucket syncs; budget must fit the task's ephemeral storage
# (default 170 GiB of the 200 GiB maximum).
#STAGING_DIR=/mnt/staging
#STAGING_BUDGET_BYTES=182536110080

# ── EFS ──────────────────────────────────────────────────────────────────────
# Where the EFS volume is mounted (read-only) in the task definition.
#EFS_MOUNT_PATH=/mnt/efs

# ── ECS export ───────────────────────────────────────────────────────────────
# Clusters whose services/task definitions are exported; unset = discover all.
#ECS_CLUSTERS=kc-production

# ── Retention and verification ───────────────────────────────────────────────
# restic forget policy: weekly snapshots for 4 weeks, monthly checkpoints for
# six months (see README). Applied per repository, grouped by tags.
# KEEP_DAILY is supported but deliberately unused; 0 omits the flag entirely.
#KEEP_DAILY=0
#KEEP_WEEKLY=4
#KEEP_MONTHLY=6
# `verify` fails if any component's newest snapshot is older than this.
#MAX_SNAPSHOT_AGE_HOURS=48
# Default target set for `backup` with no arguments. May include DB source
# names, e.g. COMPONENTS=ecs,efs,s3,wordpress
#COMPONENTS=ecs,db,efs,s3

# ── Notifications ────────────────────────────────────────────────────────────
# ntfy notifiees (optional, numbered from 1, no gaps): each target is POSTed
# on success and failure of every operation and may point at a different
# server/topic. URL and TOPIC are required per target; PASSWORD is required
# when USER is set (HTTP Basic auth).
#NTFY_1_URL=https://ntfy.example.org
#NTFY_1_TOPIC=kc-backups
#NTFY_1_USER=backup
#NTFY_1_PASSWORD=change-me
#NTFY_2_URL=https://ntfy.sh
#NTFY_2_TOPIC=kc-oncall

# Email: sent on errors only. HOST and FROM are required when EMAIL_TO is set.
#EMAIL_TO=ops@example.org,martin@example.org
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=mailer
#SMTP_PASSWORD=change-me
#SMTP_FROM=backups@example.org

# Dead-man switch (healthchecks.io style): pinged on success, <url>/fail on
# failure. The weekly verify freshness check is the backstop if the task never
# launches at all.
#PING_URL=https://hc-ping.com/xxxxxxxx-xxxx
